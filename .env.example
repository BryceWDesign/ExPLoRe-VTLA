# ExPLoRe — local environment overrides
#
# Copy this file to `.env` (which is gitignored) and edit the values to match
# your setup. The .env file is sourced by scripts/pretrain.sh + scripts/smoke_train_real.sh.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your real paths
#   sbatch scripts/pretrain.sh configs/pretrain_explore_2exp.yaml

# Wandb entity (optional — if unset, wandb uses your default)
export WANDB_ENTITY=""

# ImageNet-1K root (must contain train/ and val/ subdirectories with class folders)
export IMAGENET_PATH="/path/to/imagenet"

# ADE20K root (must contain images/ and annotations/ subdirectories)
export ADE20K_PATH="/path/to/ADEChallengeData2016"

# SLURM partition + QOS + account (defaults to ai-tenn; override for other clusters)
# export SLURM_PARTITION="ai-tenn"
# export SLURM_QOS="ai-tenn"
# export SLURM_ACCOUNT="isaac-utk0256"
